board = [
    ['O', ' ', 'X'],
    ['X', ' ', ' '],
    ['X ', 'O', 'O']
]

def display():
    print()
    for row in board:
        print(" | ".join(row))
        print("---------")
    print()

def check_winner(player):
    for i in range(3):
        if board[i][0] == board[i][1] == board[i][2] == player:
            return True
        if board[0][i] == board[1][i] == board[2][i] == player:
            return True

    if board[0][0] == board[1][1] == board[2][2] == player:
        return True

    if board[0][2] == board[1][1] == board[2][0] == player:
        return True

    return False

def is_draw():
    for row in board:
        if ' ' in row:
            return False
    return True

def computer_move():
    # Check if computer can win
    for i in range(3):
        for j in range(3):
            if board[i][j] == ' ':
                board[i][j] = 'O'
                if check_winner('O'):
                    return
                board[i][j] = ' '

    # Block human from winning
    for i in range(3):
        for j in range(3):
            if board[i][j] == ' ':
                board[i][j] = 'X'
                if check_winner('X'):
                    board[i][j] = 'O'
                    return
                board[i][j] = ' '

    # Take first available position
    for i in range(3):
        for j in range(3):
            if board[i][j] == ' ':
                board[i][j] = 'O'
                return

def human_move():
    while True:
        pos = int(input("Enter your position (1-9): "))

        row = (pos - 1) // 3
        col = (pos - 1) % 3

        if 1 <= pos <= 9 and board[row][col] == ' ':
            board[row][col] = 'X'
            return
        else:
            print("Invalid position. Try again.")

print("TIC-TAC-TOE")
print("Human = X")
print("Computer = O")

display()

while True:
    # Human's turn
    human_move()
    display()

    if check_winner('X'):
        print("Human wins!")
        break

    if is_draw():
        print("Game is a draw!")
        break

    # Computer's turn
    print("Computer's turn...")
    computer_move()
    display()

    if check_winner('O'):
        print("Computer wins!")
        break

    if is_draw():
        print("Game is a draw!")
        break
